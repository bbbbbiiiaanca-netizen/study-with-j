// ============================================================
// Firestore Security Rules 초안
// 상태: 검토용 초안 — Firebase Console에 직접 적용 금지
// 적용 전 반드시 관리자 승인 및 전체 로그인 테스트 완료 필요
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---- 헬퍼 함수 ----
    function isAdmin()   { return request.auth != null && request.auth.token.role == 'admin'; }
    function isStudent() { return request.auth != null && request.auth.token.role == 'student'; }
    function isParent()  { return request.auth != null && request.auth.token.role == 'parent'; }
    function isUser()    { return request.auth != null; }
    // 요청자의 studentId claim이 문서의 특정 필드와 일치하는가
    function myStudent(field) {
      return request.auth != null && request.auth.token.studentId == resource.data[field];
    }
    // 쓰기 요청의 studentId가 자신의 것인가
    function writingMyStudent(field) {
      return request.auth != null && request.auth.token.studentId == request.resource.data[field];
    }

    // ---- students ----
    // 관리자: 전체 CRUD
    // 학생/학부모: 자신 문서만 읽기 (students/{studentId})
    match /students/{id} {
      allow read: if isAdmin() || (isUser() && request.auth.token.studentId == id);
      allow write, delete: if isAdmin();
    }

    // ---- homework ----
    match /homework/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- homework_locks ----
    match /homework_locks/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- progress ----
    match /progress/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- comments ----
    match /comments/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- announcements ----
    match /announcements/{id} {
      allow read: if isUser();
      allow write, delete: if isAdmin();
    }

    // ---- student_schedules ----
    match /student_schedules/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- schedule_events ----
    match /schedule_events/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- schedule_published ----
    match /schedule_published/{id} {
      allow read: if isUser();
      allow write, delete: if isAdmin();
    }

    // ---- schedule_locks ----
    match /schedule_locks/{id} {
      allow read, write, delete: if isAdmin();
    }

    // ---- monthly_targets ----
    match /monthly_targets/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- lessons ----
    // 학부모는 자신 자녀 수업일지에 parentReply만 쓸 수 있음
    match /lessons/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isParent() && myStudent('studentId')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentReply']));
    }

    // ---- biweekly_reports ----
    match /biweekly_reports/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- feedbacks ----
    // 학생/학부모: 자신 피드백 생성+읽기, 관리자: 전체 + adminReply 업데이트
    match /feedbacks/{id} {
      allow read: if isAdmin() || (isUser() && myStudent('studentId'));
      allow create: if isUser() && writingMyStudent('studentId');
      allow update: if isAdmin()
        || (isUser() && myStudent('studentId')
            && !('adminReply' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    // ---- tuition_payments ----
    // 학부모만 자신 자녀 결제 정보 읽기 가능, 학생은 접근 불가
    match /tuition_payments/{id} {
      allow read: if isAdmin() || (isParent() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- tuition_settings ----
    match /tuition_settings/{id} {
      allow read: if isAdmin() || (isParent() && myStudent('studentId'));
      allow write, delete: if isAdmin();
    }

    // ---- notification_tokens ----
    // 로그인 사용자는 자신의 토큰 문서 쓰기 가능, 읽기는 관리자만
    match /notification_tokens/{id} {
      allow read: if isAdmin();
      allow write: if isUser();
    }

    // ---- push_tests ----
    match /push_tests/{id} {
      allow read, write: if isAdmin();
    }
  }
}
